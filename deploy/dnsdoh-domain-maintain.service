[Unit]
Description=Apply DNSDOH controller unified-domain certificates
After=network-online.target nginx.service dnsdoh@controller.service
RequiresMountsFor=/opt/dnsdoh
[Service]
Type=oneshot
EnvironmentFile=/opt/dnsdoh/runtime/controller.env
ExecStart=/opt/dnsdoh/DNSDOH/target/release/dnsdoh controller-maintain --root /opt/dnsdoh/runtime/direct-tls
UMask=0077
StandardOutput=append:/opt/dnsdoh/runtime/domain-maintain.log
StandardError=append:/opt/dnsdoh/runtime/domain-maintain.log
