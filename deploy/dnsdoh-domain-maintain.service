[Unit]
Description=Apply DNSDOH controller unified-domain certificates
After=network-online.target nginx.service dnsdoh@controller.service
RequiresMountsFor=/mnt/youlin-data
[Service]
Type=oneshot
EnvironmentFile=/mnt/youlin-data/runtime/controller.env
ExecStart=/mnt/youlin-data/DNSDOH/target/release/dnsdoh controller-maintain
UMask=0077
StandardOutput=append:/mnt/youlin-data/runtime/domain-maintain.log
StandardError=append:/mnt/youlin-data/runtime/domain-maintain.log
