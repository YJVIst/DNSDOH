# Copy outside the repository and chmod 600. Values are literal, without quotes.
DATABASE_URL=mysql://dnsdoh:REPLACE_DATABASE_PASSWORD@127.0.0.1:3306/dnsdoh
DNSDOH_MODE=controller
DNSDOH_BIND=127.0.0.1:18080
DNSDOH_PUBLIC_URL=https://dnsdoh-admin.example.com
DNSDOH_DOH_URL=https://doh.example.com
DNSDOH_ADMIN_USERNAME=admin
DNSDOH_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_12_BYTES
DNSDOH_TRUST_PROXY=true
RUST_LOG=dnsdoh=info

# Generated by scripts/install-controller-maintenance.py; preserve with backups.
DNSDOH_MASTER_KEY=REPLACE_WITH_BASE64URL_32_RANDOM_BYTES
DNSDOH_ADVERTISE_IP=REPLACE_WITH_CONTROLLER_PUBLIC_IP
