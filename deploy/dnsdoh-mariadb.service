[Unit]
Description=DNSDOH isolated MariaDB
After=network.target
RequiresMountsFor=/mnt/youlin-data
StartLimitIntervalSec=0

[Service]
Type=simple
User=dnsdoh-db
Group=dnsdoh-db
Environment=LD_LIBRARY_PATH=/mnt/youlin-data/tools/mariadb-root/usr/lib/x86_64-linux-gnu
ExecStart=/mnt/youlin-data/tools/mariadb-root/usr/sbin/mariadbd --no-defaults --basedir=/mnt/youlin-data/tools/mariadb-root/usr --datadir=/mnt/youlin-data/runtime/mariadb --socket=/mnt/youlin-data/runtime/mariadb-run/mariadb.sock --pid-file=/mnt/youlin-data/runtime/mariadb-run/mariadb.pid --port=13306 --bind-address=127.0.0.1 --skip-log-bin --innodb-buffer-pool-size=128M --tmpdir=/mnt/youlin-data/runtime/mariadb-run/tmp --log-error=/mnt/youlin-data/runtime/mariadb-run/error.log
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
LimitNOFILE=32768
StandardOutput=append:/mnt/youlin-data/runtime/mariadb-console.log
StandardError=append:/mnt/youlin-data/runtime/mariadb-console.log
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/youlin-data/runtime/mariadb /mnt/youlin-data/runtime/mariadb-run
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
