[Unit]
Description=DNSDOH isolated MariaDB
After=network.target
RequiresMountsFor=/opt/dnsdoh
StartLimitIntervalSec=0

[Service]
Type=simple
User=dnsdoh-db
Group=dnsdoh-db
ExecStart=/usr/sbin/mariadbd --no-defaults --basedir=/usr --datadir=/opt/dnsdoh/runtime/mariadb --socket=/opt/dnsdoh/runtime/mariadb-run/mariadb.sock --pid-file=/opt/dnsdoh/runtime/mariadb-run/mariadb.pid --port=13306 --bind-address=127.0.0.1 --skip-log-bin --innodb-buffer-pool-size=128M --tmpdir=/opt/dnsdoh/runtime/mariadb-run/tmp --log-error=/opt/dnsdoh/runtime/mariadb-run/error.log
Restart=on-failure
RestartSec=3
TimeoutStopSec=90
LimitNOFILE=32768
StandardOutput=append:/opt/dnsdoh/runtime/mariadb-console.log
StandardError=append:/opt/dnsdoh/runtime/mariadb-console.log
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dnsdoh/runtime/mariadb /opt/dnsdoh/runtime/mariadb-run
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
