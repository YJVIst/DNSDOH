[Unit]
Description=Renew DNSDOH HTTPS certificates
After=network-online.target nginx.service
Wants=network-online.target
RequiresMountsFor=/opt/dnsdoh

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --quiet --cert-name dnsdoh --config-dir /opt/dnsdoh/runtime/letsencrypt --work-dir /opt/dnsdoh/runtime/certbot-work --logs-dir /opt/dnsdoh/runtime/certbot-logs --deploy-hook /opt/dnsdoh/DNSDOH/scripts/reload-nginx.sh
StandardOutput=append:/opt/dnsdoh/runtime/cert-renew.log
StandardError=append:/opt/dnsdoh/runtime/cert-renew.log
