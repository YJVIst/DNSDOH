# Prefer the dashboard one-time installer; it generates this identity locally.
# For an existing deployment, use `dnsdoh enroll` with the ticket on stdin.
DNSDOH_MODE=node
DNSDOH_BIND=127.0.0.1:18081
DNSDOH_PUBLIC_URL=https://doh-hk.example.com
DNSDOH_CONTROLLER_URL=https://dnsdoh-admin.example.com
DNSDOH_NODE_ID=REPLACE_WITH_NODE_UUID
DNSDOH_NODE_PRIVATE_KEY=LOCALLY_GENERATED_BASE64URL_32_BYTE_PRIVATE_SEED
DNSDOH_TRUST_PROXY=true
RUST_LOG=dnsdoh=info
