[Unit]
Description=Back up DNSDOH MariaDB
After=dnsdoh-mariadb.service
Requires=dnsdoh-mariadb.service
RequiresMountsFor=/opt/dnsdoh

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/dnsdoh/DNSDOH/scripts/backup.py
UMask=0077
StandardOutput=append:/opt/dnsdoh/runtime/backup.log
StandardError=append:/opt/dnsdoh/runtime/backup.log
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dnsdoh/runtime/backups
