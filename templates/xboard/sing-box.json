{
  "dns": {
    "rules": [
      {
        "domain_suffix": [
          "nodes.example.com"
        ],
        "action": "route",
        "server": "dnsdoh-private"
      },
      {
        "domain": [
          "doh.example.com"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "clash_mode": "global",
        "server": "remote",
        "action": "route"
      },
      {
        "clash_mode": "direct",
        "server": "local",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "local",
        "action": "route"
      }
    ],
    "servers": [
      {
        "type": "https",
        "tag": "remote",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "节点选择"
      },
      {
        "type": "https",
        "tag": "local",
        "server": "223.5.5.5",
        "path": "/dns-query"
      },
      {
        "type": "https",
        "tag": "dnsdoh-private",
        "server": "doh.example.com",
        "path": "/dns-query/YOUR_DNSDOH_TOKEN",
        "domain_resolver": "local"
      },
      {
        "type": "https",
        "tag": "dnsdoh-compatible",
        "server": "doh.example.com",
        "path": "/dns-query/compat/YOUR_DNSDOH_TOKEN",
        "domain_resolver": "local"
      }
    ],
    "strategy": "prefer_ipv4",
    "final": "remote"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "cache_db",
      "store_fakeip": true
    }
  },
  "inbounds": [
    {
      "auto_route": true,
      "address": [
        "172.19.0.1/30",
        "2001:0470:f9da:fdfa::1/64"
      ],
      "mtu": 9000,
      "stack": "system",
      "strict_route": true,
      "type": "tun"
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2333,
      "tag": "socks-in",
      "type": "socks",
      "users": []
    },
    {
      "listen": "127.0.0.1",
      "listen_port": 2334,
      "tag": "mixed-in",
      "type": "mixed",
      "users": []
    }
  ],
  "outbounds": [
    {
      "tag": "节点选择",
      "type": "selector",
      "default": "自动选择",
      "outbounds": [
        "自动选择"
      ]
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "自动选择",
      "type": "urltest",
      "outbounds": []
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "global",
        "outbound": "节点选择"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "download_detour": "自动选择"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "自动选择"
      }
    ],
    "default_domain_resolver": {
      "server": "dnsdoh-compatible",
      "strategy": "prefer_ipv4"
    }
  }
}
